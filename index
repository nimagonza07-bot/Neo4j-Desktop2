<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neo4j Desktop & Browser - Simulador Interactivo</title>
<style>
  :root {
    --bg-app: #0b0e14;
    --bg-sidebar: #111622;
    --bg-panel: #161c2c;
    --bg-card: #1c2438;
    --bg-card-hover: #232d45;
    --bg-input: #0e131f;
    --border-color: #28324a;
    --text-main: #f1f5f9;
    --text-muted: #94a3b8;
    --accent-blue: #008cc1;
    --accent-blue-hover: #00a3e0;
    --accent-green: #10b981;
    --accent-green-hover: #059669;
    --accent-red: #ef4444;
    --accent-yellow: #f59e0b;
    --accent-purple: #8b5cf6;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: var(--bg-app);
    color: var(--text-main);
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    user-select: none;
  }

  .app-view {
    display: none;
    height: 100vh;
    width: 100vw;
  }

  .app-view.active {
    display: flex;
  }

  .desktop-sidebar {
    width: 240px;
    background-color: var(--bg-sidebar);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .brand-header {
    padding: 20px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-logo {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: linear-gradient(135deg, #008cc1, #10b981);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
    color: #fff;
    box-shadow: 0 4px 12px rgba(0, 140, 193, 0.3);
  }

  .brand-title {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.3px;
  }

  .brand-sub {
    font-size: 11px;
    color: var(--text-muted);
    display: block;
  }

  .nav-menu {
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }

  .nav-btn:hover {
    background-color: var(--bg-card);
    color: var(--text-main);
  }

  .nav-btn.active {
    background-color: rgba(0, 140, 193, 0.15);
    color: #38bdf8;
    border-left: 3px solid var(--accent-blue);
    font-weight: 600;
  }

  .sidebar-footer {
    padding: 16px;
    border-top: 1px solid var(--border-color);
    font-size: 12px;
    color: var(--text-muted);
  }

  .desktop-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--bg-app);
  }

  .topbar {
    height: 60px;
    background-color: var(--bg-panel);
    border-bottom: 1px solid var(--border-color);
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar-breadcrumb {
    font-size: 14px;
    color: var(--text-muted);
  }

  .topbar-breadcrumb span {
    color: var(--text-main);
    font-weight: 600;
  }

  .status-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 20px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    font-size: 12px;
    font-weight: 600;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #64748b;
  }

  .status-indicator.active {
    background-color: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
  }

  .status-indicator.starting {
    background-color: var(--accent-yellow);
    box-shadow: 0 0 8px var(--accent-yellow);
  }

  .section-container {
    display: none;
    flex: 1;
    padding: 28px;
    overflow-y: auto;
  }

  .section-container.active {
    display: block;
  }

  .section-header {
    margin-bottom: 24px;
  }

  .section-header h1 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .section-header p {
    font-size: 14px;
    color: var(--text-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .project-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .project-card:hover {
    background-color: var(--bg-card-hover);
    transform: translateY(-2px);
  }

  .project-card.selected {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 1px var(--accent-blue), 0 8px 20px rgba(0, 140, 193, 0.15);
  }

  .project-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    background-color: rgba(0, 140, 193, 0.15);
    color: #38bdf8;
    margin-bottom: 12px;
  }

  .project-card h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }

  .project-card p {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
    border-top: 1px solid var(--border-color);
    padding-top: 12px;
  }

  .dbms-split {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 24px;
    height: calc(100vh - 170px);
    min-height: 460px;
  }

  .dbms-instance-card {
    background-color: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .db-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .db-state-badge {
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background-color: rgba(100, 116, 139, 0.2);
    color: #94a3b8;
  }

  .db-state-badge.active {
    background-color: rgba(16, 185, 129, 0.18);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .db-state-badge.starting {
    background-color: rgba(245, 158, 11, 0.18);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .db-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .db-uri {
    font-family: monospace;
    font-size: 13px;
    color: #38bdf8;
    background-color: var(--bg-input);
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    display: inline-block;
    margin-bottom: 20px;
  }

  .db-info-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    font-size: 13px;
  }

  .db-info-row {
    display: flex;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(40, 50, 74, 0.6);
  }

  .db-info-row span:first-child {
    color: var(--text-muted);
  }

  .db-controls {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn-row {
    display: flex;
    gap: 10px;
  }

  .btn {
    flex: 1;
    padding: 11px 16px;
    border-radius: 8px;
    border: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .btn-start {
    background-color: var(--accent-green);
    color: #fff;
  }

  .btn-start:hover:not(:disabled) {
    background-color: var(--accent-green-hover);
  }

  .btn-stop {
    background-color: var(--bg-card);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .btn-stop:hover:not(:disabled) {
    background-color: rgba(239, 68, 68, 0.15);
  }

  .btn-open {
    background-color: var(--accent-blue);
    color: #fff;
    width: 100%;
  }

  .btn-open:hover {
    background-color: var(--accent-blue-hover);
  }

  .dbms-inspector {
    background-color: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .inspector-tabs {
    display: flex;
    background-color: var(--bg-sidebar);
    border-bottom: 1px solid var(--border-color);
    padding: 0 16px;
  }

  .tab-btn {
    padding: 14px 20px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .tab-btn:hover {
    color: var(--text-main);
  }

  .tab-btn.active {
    color: #38bdf8;
    border-bottom-color: var(--accent-blue);
  }

  .tab-content {
    display: none;
    padding: 24px;
    flex: 1;
    overflow-y: auto;
  }

  .tab-content.active {
    display: block;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .metric-box {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 16px;
  }

  .metric-label {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .metric-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-main);
  }

  .metric-bar-bg {
    height: 6px;
    background-color: var(--bg-input);
    border-radius: 3px;
    margin-top: 10px;
    overflow: hidden;
  }

  .metric-bar-fill {
    height: 100%;
    background-color: var(--accent-blue);
    width: 0%;
    transition: width 0.5s ease;
  }

  .detail-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .detail-table td {
    padding: 12px 8px;
    border-bottom: 1px solid var(--border-color);
  }

  .detail-table td:first-child {
    color: var(--text-muted);
    width: 40%;
  }

  .detail-table td:last-child {
    font-family: monospace;
    color: var(--text-main);
  }

  .plugin-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 18px;
    margin-bottom: 16px;
  }

  .plugin-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .plugin-title {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .plugin-installed-tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(16, 185, 129, 0.2);
    color: #34d399;
    display: none;
  }

  .plugin-installed-tag.visible {
    display: inline-block;
  }

  .plugin-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .btn-plugin {
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid var(--accent-blue);
    background-color: rgba(0, 140, 193, 0.15);
    color: #38bdf8;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-plugin:hover {
    background-color: var(--accent-blue);
    color: #fff;
  }

  .btn-plugin.installed {
    border-color: rgba(239, 68, 68, 0.4);
    background-color: rgba(239, 68, 68, 0.1);
    color: #f87171;
  }

  .btn-plugin.installed:hover {
    background-color: var(--accent-red);
    color: #fff;
  }

  .plugin-progress {
    height: 4px;
    background-color: var(--bg-input);
    border-radius: 2px;
    margin-top: 12px;
    overflow: hidden;
    display: none;
  }

  .plugin-progress.active {
    display: block;
  }

  .plugin-progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--accent-green);
    transition: width 0.2s linear;
  }

  .conf-editor {
    width: 100%;
    height: 300px;
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 16px;
    color: #a5b4fc;
    font-family: 'Fira Code', monospace;
    font-size: 13px;
    line-height: 1.6;
    resize: none;
    outline: none;
  }

  .log-console {
    background-color: #07090e;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 16px;
    height: 310px;
    overflow-y: auto;
    font-family: monospace;
    font-size: 12px;
    line-height: 1.6;
  }

  .log-line {
    margin-bottom: 4px;
  }

  .log-time {
    color: #64748b;
  }

  .log-info {
    color: #38bdf8;
  }

  .log-ok {
    color: #34d399;
  }

  .log-warn {
    color: #fbbf24;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .app-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .app-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 16px;
  }

  .browser-view {
    flex-direction: column;
    background-color: #0d111a;
  }

  .browser-topbar {
    height: 54px;
    background-color: #131826;
    border-bottom: 1px solid var(--border-color);
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .browser-left-info {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .browser-badge {
    background-color: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-family: monospace;
  }

  .btn-back-desktop {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 7px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-back-desktop:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--accent-blue);
  }

  .cypher-bar {
    background-color: #161d2e;
    border-bottom: 1px solid var(--border-color);
    padding: 14px 20px;
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .cypher-prompt {
    font-family: monospace;
    font-weight: 700;
    color: var(--accent-green);
    font-size: 15px;
  }

  .cypher-select {
    background-color: var(--bg-input);
    color: var(--text-main);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    outline: none;
    cursor: pointer;
    min-width: 280px;
  }

  .cypher-code-box {
    flex: 1;
    background-color: var(--bg-input);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 14px;
    font-family: 'Fira Code', monospace;
    font-size: 13px;
    color: #38bdf8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .btn-play {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-green));
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 14px rgba(0, 140, 193, 0.35);
    transition: transform 0.15s ease;
  }

  .btn-play:hover {
    transform: scale(1.03);
  }

  .browser-workspace {
    flex: 1;
    display: flex;
    overflow: hidden;
    position: relative;
  }

  .canvas-wrapper {
    flex: 1;
    position: relative;
    background-color: #0b0e14;
    background-image: radial-gradient(#1e293b 1px, transparent 1px);
    background-size: 24px 24px;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  canvas:active {
    cursor: grabbing;
  }

  .canvas-legend {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: rgba(22, 28, 44, 0.9);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    gap: 14px;
    font-size: 12px;
    backdrop-filter: blur(6px);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .browser-inspector {
    width: 320px;
    background-color: var(--bg-panel);
    border-left: 1px solid var(--border-color);
    padding: 20px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .inspector-header {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-muted);
    font-weight: 700;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 16px;
  }

  .prop-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .prop-row {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 12px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    font-size: 13px;
  }

  .prop-key {
    color: var(--text-muted);
    font-family: monospace;
  }

  .prop-val {
    color: var(--text-main);
    font-weight: 600;
  }

  .toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .toast {
    background-color: var(--bg-panel);
    border-left: 4px solid var(--accent-yellow);
    border-top: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 14px 18px;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    font-size: 13px;
    max-width: 360px;
    animation: slideIn 0.25s ease;
  }

  .toast.info {
    border-left-color: var(--accent-blue);
  }

  .toast.success {
    border-left-color: var(--accent-green);
  }

  @keyframes slideIn {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
</style>
</head>
<body>

<div id="view-desktop" class="app-view active">
  <aside class="desktop-sidebar">
    <div class="brand-header">
      <div class="brand-logo">N4J</div>
      <div>
        <div class="brand-title">Neo4j Desktop</div>
        <span class="brand-sub">v1.6.1 Enterprise</span>
      </div>
    </div>
    <nav class="nav-menu">
      <button class="nav-btn active" data-section="projects">Proyectos</button>
      <button class="nav-btn" data-section="dbms">DBMSs</button>
      <button class="nav-btn" data-section="apps">Graph Apps</button>
    </nav>
    <div class="sidebar-footer">
      Entorno Local: localhost<br>
      Motor: Neo4j 5.24.0
    </div>
  </aside>

  <main class="desktop-main">
    <header class="topbar">

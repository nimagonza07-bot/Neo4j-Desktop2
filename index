  function showToast(message, type = 'warn') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = 'toast ' + type;
    toast.textContent = message;
    container.appendChild(toast);
    setTimeout(function() {
      toast.style.opacity = '0';
      toast.style.transition = 'opacity 0.3s ease';
      setTimeout(function() {
        if (toast.parentNode) {
          toast.parentNode.removeChild(toast);
        }
      }, 300);
    }, 3500);
  }

  function appendLog(level, message) {
    const consoleEl = document.getElementById('log-console');
    const now = new Date();
    const ts = now.toISOString().replace('T', ' ').substring(0, 19);
    const line = document.createElement('div');
    line.className = 'log-line';
    let levelClass = 'log-info';
    if (level === 'SUCCESS') levelClass = 'log-ok';
    if (level === 'WARN') levelClass = 'log-warn';
    line.innerHTML = '<span class="log-time">[' + ts + ']</span> <span class="' + levelClass + '">' + level + '</span> ' + message;
    consoleEl.appendChild(line);
    consoleEl.scrollTop = consoleEl.scrollHeight;
  }

  appendLog('INFO', 'Neo4j Desktop inicializado. Instancia "' + state.activeDb + '" en espera.');

  const navBtns = document.querySelectorAll('.nav-btn');
  const sections = document.querySelectorAll('.section-container');

  function switchDesktopSection(sectionName) {
    navBtns.forEach(function(b) {
      b.classList.toggle('active', b.getAttribute('data-section') === sectionName);
    });
    sections.forEach(function(s) {
      s.classList.toggle('active', s.id === 'sec-' + sectionName);
    });
  }

  navBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      switchDesktopSection(btn.getAttribute('data-section'));
    });
  });


      'server.bolt.listen_address=:7687',
      'server.http.enabled=true',
      'server.http.listen_address=:7474',
      'server.memory.heap.initial_size=1G',
      'server.memory.heap.max_size=2G',
      'server.memory.pagecache.size=512M',
      'dbms.security.auth_enabled=true'
    ];
    const unrestricted = ['jwt.security.*'];
    if (state.plugins.apoc) unrestricted.push('apoc.*');
    if (state.plugins.gds) unrestricted.push('gds.*');
    lines.push('dbms.security.procedures.unrestricted=' + unrestricted.join(','));
    document.getElementById('conf-textarea').value = lines.join('\n');

    let count = 0;
    if (state.plugins.apoc) count++;
    if (state.plugins.gds) count++;
    document.getElementById('sidebar-plugins-count').textContent = count + ' instalados';
  }

  function setupPluginButton(key, fullName) {
    const btn = document.getElementById('btn-plugin-' + key);
    const prog = document.getElementById('prog-' + key);
    const fill = document.getElementById('fill-' + key);
    const tag = document.getElementById('tag-' + key);

    btn.addEventListener('click', function() {
      if (state.plugins[key]) {
        state.plugins[key] = false;
        btn.textContent = 'Instalar';
        btn.classList.remove('installed');
        tag.classList.remove('visible');
        updateConfigFile();
        appendLog('WARN', 'Plugin desinstalado: ' + fullName);
        showToast('Plugin ' + fullName + ' desinstalado.', 'info');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Instalando...';
      prog.classList.add('active');
      fill.style.width = '10%';
      appendLog('INFO', 'Descargando paquete ' + fullName + '...');

      setTimeout(function() { fill.style.width = '55%'; }, 300);
      setTimeout(function() { fill.style.width = '90%'; }, 650);
      setTimeout(function() {
        fill.style.width = '100%';
        prog.classList.remove('active');
        fill.style.width = '0%';
        btn.disabled = false;
        btn.textContent = 'Desinstalar';
        btn.classList.add('installed');
        tag.classList.add('visible');
        state.plugins[key] = true;
        updateConfigFile();
        appendLog('SUCCESS', 'Plugin ' + fullName + ' instalado y registrado en neo4j.conf');
        showToast('Plugin ' + fullName + ' instalado correctamente.', 'success');
      }, 1000);
    });
  }

  setupPluginButton('apoc', 'APOC 5.24.0');
  setupPluginButton('gds', 'Graph Data Science 2.12');

  function openNeo4jBrowser() {
    if (state.dbStatus !== 'ACTIVE') {
      showToast('Aviso: Primero debes iniciar el servidor DBMS (botón Start) antes de abrir Neo4j Browser.', 'warn');
      switchDesktopSection('dbms');
      return;
    }
    document.getElementById('view-desktop').classList.remove('active');
    document.getElementById('view-browser').classList.add('active');
    document.getElementById('browser-conn-badge').textContent = 'Conectado: ' + state.activeDb + ' (bolt://localhost:7687)';
    resizeCanvas();
    loadPreset(parseInt(document.getElementById('cypher-preset').value, 10));
  }

  document.getElementById('btn-db-open').addEventListener('click', openNeo4jBrowser);
  document.getElementById('btn-launch-browser-app').addEventListener('click', openNeo4jBrowser);

  document.getElementById('btn-bloom-info').addEventListener('click', function() {
    showToast('Neo4j Bloom requiere licencia Enterprise activa para exploración sin código.', 'info');
  });

  document.getElementById('btn-return-desktop').addEventListener('click', function() {
    document.getElementById('view-browser').classList.remove('active');
    document.getElementById('view-desktop').classList.add('active');
  });

  const canvas = document.getElementById('graph-canvas');
  const ctx = canvas.getContext('2d');
  let simNodes = [];
  let simEdges = [];
  let draggedNode = null;
  let selectedItem = null;
  let animationId = null;

  function resizeCanvas() {
    const wrapper = document.getElementById('canvas-wrapper');
    canvas.width = wrapper.clientWidth;
    canvas.height = wrapper.clientHeight;
  }

  window.addEventListener('resize', resizeCanvas);

  function loadPreset(index) {
    const preset = presets[index];
    document.getElementById('cypher-display').textContent = preset.query;
    const cx = canvas.width / 2 || 400;
    const cy = canvas.height / 2 || 300;

    simNodes = preset.nodes.map(function(n, idx) {
      const angle = (idx / preset.nodes.length) * Math.PI * 2;
      return {
        id: n.id,
        label: n.label,
        group: n.group,
        color: n.color,
        props: n.props,
        x: cx + Math.cos(angle) * 140,
        y: cy + Math.sin(angle) * 140,
        vx: 0,
        vy: 0,
        radius: 30
      };
    });

    simEdges = preset.edges.map(function(e) {
      return {
        id: e.id,
        from: e.from,
        to: e.to,
        label: e.label,
        props: e.props
      };
    });

    selectedItem = null;
    renderInspector(null);
  }

  document.getElementById('cypher-preset').addEventListener('change', function(e) {
    const idx = parseInt(e.target.value, 10);
    document.getElementById('cypher-display').textContent = presets[idx].query;
  });

  document.getElementById('btn-run-cypher').addEventListener('click', function() {
    const idx = parseInt(document.getElementById('cypher-preset').value, 10);
    loadPreset(idx);
    showToast('Consulta Cypher ejecutada en 12 ms.', 'success');
  });

  function renderInspector(item) {
    const body = document.getElementById('inspector-body');
    if (!item) {
      body.innerHTML = '<p style="font-size:13px; color:var(--text-muted); line-height:1.5;">Haz clic sobre cualquier <strong>nodo</strong> o <strong>relación</strong> en el lienzo central para inspeccionar sus etiquetas, propiedades internas e identificador.</p>';
      return;
    }

    let html = '';
    if (item.type === 'node') {
      html += '<span class="prop-badge" style="background:' + item.data.color + '33; color:' + item.data.color + '; border:1px solid ' + item.data.color + ';">:' + item.data.group + '</span>';
      html += '<div class="prop-row"><span class="prop-key">&lt;id&gt;</span><span class="prop-val">' + item.data.id + '</span></div>';
    } else {
      html += '<span class="prop-badge" style="background:rgba(148,163,184,0.2); color:#e2e8f0; border:1px solid #64748b;">[:' + item.data.label + ']</span>';
      html += '<div class="prop-row"><span class="prop-key">&lt;type&gt;</span><span class="prop-val">' + item.data.label + '</span></div>';
    }

    const keys = Object.keys(item.data.props);
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i];
      html += '<div class="prop-row"><span class="prop-key">' + k + '</span><span class="prop-val">' + item.data.props[k] + '</span></div>';
    }
    body.innerHTML = html;
  }

  function stepPhysics() {
    const width = canvas.width;
    const height = canvas.height;
    const cx = width / 2;
    const cy = height / 2;

    for (let i = 0; i < simNodes.length; i++) {
      const n1 = simNodes[i];
      if (n1 === draggedNode) continue;

      n1.vx += (cx - n1.x) * 0.008;
      n1.vy += (cy - n1.y) * 0.008;

      for (let j = 0; j < simNodes.length; j++) {
        if (i === j) continue;
        const n2 = simNodes[j];
        const dx = n1.x - n2.x;
        const dy = n1.y - n2.y;
        const distSq = dx * dx + dy * dy || 1;
        const dist = Math.sqrt(distSq);
        if (dist < 280) {
          const force = 3200 / distSq;
          n1.vx += (dx / dist) * force;
          n1.vy += (dy / dist) * force;
        }
      }
    }

    for (let i = 0; i < simEdges.length; i++) {
      const e = simEdges[i];
      const source = simNodes.find(function(n) { return n.id === e.from; });
      const target = simNodes.find(function(n) { return n.id === e.to; });
      if (!source || !target) continue;

      const dx = target.x - source.x;
      const dy = target.y - source.y;
      const dist = Math.sqrt(dx * dx + dy * dy) || 1;
      const desired = 190;
      const pull = (dist - desired) * 0.025;

      const fx = (dx / dist) * pull;
      const fy = (dy / dist) * pull;

      if (source !== draggedNode) {
        source.vx += fx;
        source.vy += fy;
      }
      if (target !== draggedNode) {
        target.vx -= fx;
        target.vy -= fy;
      }
    }

    for (let i = 0; i < simNodes.length; i++) {
      const n = simNodes[i];
      if (n === draggedNode) continue;
      n.vx *= 0.84;
      n.vy *= 0.84;
      n.x += n.vx;
      n.y += n.vy;

      const pad = 45;
      if (n.x < pad) { n.x = pad; n.vx = 0; }
      if (n.x > width - pad) { n.x = width - pad; n.vx = 0; }
      if (n.y < pad) { n.y = pad; n.vy = 0; }
      if (n.y > height - pad) { n.y = height - pad; n.vy = 0; }
    }
  }

  function drawGraph() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (let i = 0; i < simEdges.length; i++) {
      const e = simEdges[i];
      const s = simNodes.find(function(n) { return n.id === e.from; });
      const t = simNodes.find(function(n) { return n.id === e.to; });
      if (!s || !t) continue;

      const angle = Math.atan2(t.y - s.y, t.x - s.x);
      const startX = s.x + Math.cos(angle) * s.radius;
      const startY = s.y + Math.sin(angle) * s.radius;
      const endX = t.x - Math.cos(angle) * (t.radius + 6);
      const endY = t.y - Math.sin(angle) * (t.radius + 6);

      const isSelected = selectedItem && selectedItem.type === 'edge' && selectedItem.data.id === e.id;

      ctx.beginPath();
      ctx.moveTo(startX, startY);
      ctx.lineTo(endX, endY);
      ctx.strokeStyle = isSelected ? '#38bdf8' : (e.label === 'RECOMENDADO' ? '#f59e0b' : '#475569');
      ctx.lineWidth = isSelected ? 3 : 2;
      if (e.label === 'RECOMENDADO') {
        ctx.setLineDash([6, 4]);
      } else {
        ctx.setLineDash([]);
      }
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.beginPath();
      ctx.moveTo(endX, endY);
      ctx.lineTo(endX - 10 * Math.cos(angle - Math.PI / 6), endY - 10 * Math.sin(angle - Math.PI / 6));
      ctx.lineTo(endX - 10 * Math.cos(angle + Math.PI / 6), endY - 10 * Math.sin(angle + Math.PI / 6));
      ctx.closePath();
      ctx.fillStyle = isSelected ? '#38bdf8' : (e.label === 'RECOMENDADO' ? '#f59e0b' : '#64748b');
      ctx.fill();

      const midX = (startX + endX) / 2;
      const midY = (startY + endY) / 2;
      e._midX = midX;
      e._midY = midY;

      ctx.font = '600 11px Inter, sans-serif';
      const textWidth = ctx.measureText(e.label).width;
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(midX - textWidth / 2 - 4, midY - 8, textWidth + 8, 16);

      ctx.fillStyle = isSelected ? '#38bdf8' : '#cbd5e1';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(e.label, midX, midY);
    }

    for (let i = 0; i < simNodes.length; i++) {
      const n = simNodes[i];
      const isSelected = selectedItem && selectedItem.type === 'node' && selectedItem.data.id === n.id;

      if (isSelected) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.radius + 6, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
        ctx.fill();
      }

      ctx.beginPath();
      ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
      ctx.fillStyle = n.color;
      ctx.fill();
      ctx.lineWidth = isSelected ? 3 : 2;
      ctx.strokeStyle = isSelected ? '#ffffff' : '#0f172a';
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.font = '700 12px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(n.label, n.x, n.y);
    }
  }

  function animateGraph() {
    if (document.getElementById('view-browser').classList.contains('active')) {
      stepPhysics();
      drawGraph();
    }
    animationId = requestAnimationFrame(animateGraph);
  }

  function getPointerPos(evt) {
    const rect = canvas.getBoundingClientRect();
    const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
    const clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
    return {
      x: clientX - rect.left,
      y: clientY - rect.top
    };
  }

  function handlePointerDown(evt) {
    const pos = getPointerPos(evt);
    for (let i = simNodes.length - 1; i >= 0; i--) {
      const n = simNodes[i];
      const dx = pos.x - n.x;
      const dy = pos.y - n.y;
      if (dx * dx + dy * dy <= n.radius * n.radius) {
        draggedNode = n;
        selectedItem = { type: 'node', data: n };
        renderInspector(selectedItem);
        return;
      }
    }

    for (let i = 0; i < simEdges.length; i++) {
      const e = simEdges[i];
      if (e._midX !== undefined) {
        const dx = pos.x - e._midX;
        const dy = pos.y - e._midY;
        if (dx * dx + dy * dy <= 400) {
          selectedItem = { type: 'edge', data: e };
          renderInspector(selectedItem);
          return;
        }
      }
    }

    selectedItem = null;
    renderInspector(null);
  }

  function handlePointerMove(evt) {
    if (!draggedNode) return;
    if (evt.cancelable) evt.preventDefault();
    const pos = getPointerPos(evt);
    draggedNode.x = pos.x;
    draggedNode.y = pos.y;
    draggedNode.vx = 0;
    draggedNode.vy = 0;
  }

  function handlePointerUp() {
    draggedNode = null;
  }

  canvas.addEventListener('mousedown', handlePointerDown);
  window.addEventListener('mousemove', handlePointerMove);
  window.addEventListener('mouseup', handlePointerUp);

  canvas.addEventListener('touchstart', handlePointerDown, { passive: false });
  window.addEventListener('touchmove', handlePointerMove, { passive: false });
  window.addEventListener('touchend', handlePointerUp);

  animateGraph();
</script>
</body>
</html>

      tabContents.forEach(function(c) { c.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('tab-' + target).classList.add('active');
    });
  });

  function updateMetrics(active) {
    const ramText = document.getElementById('metric-ram');
    const barRam = document.getElementById('bar-ram');
    const cpuText = document.getElementById('metric-cpu');
    const barCpu = document.getElementById('bar-cpu');

    if (!active) {
      if (state.metricsTimer) clearInterval(state.metricsTimer);
      ramText.textContent = '0 MB / 2048 MB';
      barRam.style.width = '0%';
      cpuText.textContent = '0.0 %';
      barCpu.style.width = '0%';
      return;
    }

    function tick() {
      const ram = Math.floor(680 + Math.random() * 140);
      const cpu = (2.1 + Math.random() * 4.5).toFixed(1);
      ramText.textContent = ram + ' MB / 2048 MB';
      barRam.style.width = Math.round((ram / 2048) * 100) + '%';
      cpuText.textContent = cpu + ' %';
      barCpu.style.width = Math.min(100, Math.round(parseFloat(cpu) * 5)) + '%';
    }
    tick();
    state.metricsTimer = setInterval(tick, 2000);
  }

  function syncStatusUI() {
    const badge = document.getElementById('db-state-badge');
    const topDot = document.getElementById('top-status-dot');
    const topLabel = document.getElementById('top-status-label');
    const btnStart = document.getElementById('btn-db-start');
    const btnStop = document.getElementById('btn-db-stop');

    badge.className = 'db-state-badge';
    topDot.className = 'status-indicator';

    if (state.dbStatus === 'STOPPED') {
      badge.textContent = 'STOPPED';
      topLabel.textContent = 'DBMS: STOPPED';
      btnStart.disabled = false;
      btnStop.disabled = true;
      updateMetrics(false);
    } else if (state.dbStatus === 'STARTING') {
      badge.textContent = 'STARTING...';
      badge.classList.add('starting');
      topDot.classList.add('starting');
      topLabel.textContent = 'DBMS: STARTING';
      btnStart.disabled = true;
      btnStop.disabled = true;
    } else if (state.dbStatus === 'ACTIVE') {
      badge.textContent = 'ACTIVE';
      badge.classList.add('active');
      topDot.classList.add('active');
      topLabel.textContent = 'DBMS: ACTIVE';
      btnStart.disabled = true;
      btnStop.disabled = false;
      updateMetrics(true);
    }
  }

  document.getElementById('btn-db-start').addEventListener('click', function() {
    if (state.dbStatus !== 'STOPPED') return;
    state.dbStatus = 'STARTING';
    syncStatusUI();
    appendLog('INFO', 'Iniciando instancia "' + state.activeDb + '" (Neo4j 5.24.0)...');
    appendLog('INFO', 'Asignando memoria JVM Heap: 1024MB inicial / 2048MB máximo.');

